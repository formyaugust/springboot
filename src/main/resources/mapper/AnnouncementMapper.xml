<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jou.mr.springboot.mapper.AnnouncementMapper">

    <resultMap id="BaseResultMap" type="jou.mr.springboot.entity.Announcement">
        <id column="announcement_id" property="announcementId"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="publisher_id" property="publisherId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insertAnnouncement" parameterType="jou.mr.springboot.entity.Announcement" useGeneratedKeys="true" keyProperty="announcementId">
        insert into announcement (title, content, publisher_id, create_time)
        values (#{title}, #{content}, #{publisherId}, #{createTime})
    </insert>

    <update id="updateAnnouncementById" parameterType="jou.mr.springboot.entity.Announcement">
        update announcement
        <set>
            <if test="title!=null">title=#{title},</if>
            <if test="content!=null">content=#{content},</if>
            <if test="publisherId!=null">publisher_id=#{publisherId},</if>
            <if test="createTime!=null">create_time=#{createTime}</if>
        </set>
        where announcement_id=#{announcementId}
    </update>

    <delete id="deleteAnnouncementById">
        delete from announcement where announcement_id = #{announcementId}
    </delete>

    <select id="selectAnnouncementById" resultMap="BaseResultMap">
        select * from announcement where announcement_id = #{announcementId}
    </select>

    <select id="selectAnnouncementAll" resultMap="BaseResultMap">
        select * from announcement
        <where>
            <if test="title!=null">and title like concat('%', #{title}, '%')</if>
            <if test="publisherId!=null">and publisher_id=#{publisherId}</if>
        </where>
        order by create_time desc,announcement_id asc
    </select>

</mapper>